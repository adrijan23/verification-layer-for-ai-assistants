APP_DISPLAY_NAME=AgentGate
CONSOLE_URL=http://localhost:3000
AGENT_URL=http://localhost:3100
GATEWAY_SHARED_SECRET=dev-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_USER_AGENT_TAG=InstinctDemo/1.0
DATABASE_PATH=./data/agentgate.db
# Shows a small "passkey not available" fallback on consent/approval screens (stage safety net)
DEMO_PASSKEY_FALLBACK=true
# Shows demo-only tools in the dashboard (e.g. "Simulate tampering")
DEMO_TOOLS=true
# Agent browser: true = headless (Docker), false = visible window (local stage run)
AGENT_HEADLESS=true
